diff --git a/supabase/migrations/20280101000000_get_user_settings_rpc.sql b/supabase/migrations/20280101000000_get_user_settings_rpc.sql
new file mode 100644
index 0000000..f95bb3f
--- /dev/null
+++ b/supabase/migrations/20280101000000_get_user_settings_rpc.sql
@@ -0,0 +1,15 @@
+CREATE OR REPLACE FUNCTION public.get_user_settings()
+RETURNS jsonb AS $$
+DECLARE
+    v_settings jsonb;
+BEGIN
+    SELECT settings INTO v_settings FROM public.user_settings WHERE user_id = auth.uid();
+
+    -- If no settings found, return an empty JSON object instead of null to prevent frontend crashes
+    IF v_settings IS NULL THEN
+        RETURN '{}'::jsonb;
+    END IF;
+
+    RETURN v_settings;
+END;
+$$ LANGUAGE plpgsql SECURITY DEFINER;
diff --git a/supabase/migrations/20280101000001_get_user_settings_array_rpc.sql b/supabase/migrations/20280101000001_get_user_settings_array_rpc.sql
new file mode 100644
index 0000000..f63531a
--- /dev/null
+++ b/supabase/migrations/20280101000001_get_user_settings_array_rpc.sql
@@ -0,0 +1,6 @@
+CREATE OR REPLACE FUNCTION public.get_user_settings_array()
+RETURNS TABLE (settings jsonb) AS $$
+BEGIN
+    RETURN QUERY SELECT COALESCE(u.settings, '{}'::jsonb) FROM public.user_settings u WHERE user_id = auth.uid();
+END;
+$$ LANGUAGE plpgsql SECURITY DEFINER;
